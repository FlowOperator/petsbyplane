{
  "expo": {
    "name": "Pets by Plane",
    "slug": "pets-by-plane",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "petsbyplane",
    "plugins": [
      "expo-router"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.petsbyplane.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F1EEE7",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.petsbyplane.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single",
      "name": "Pets by Plane",
      "shortName": "PBP",
      "description": "Fly your pet anywhere in the world",
      "backgroundColor": "#F1EEE7",
      "themeColor": "#E8623D"
    },
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/petsbyplane"
    }
  }
}
